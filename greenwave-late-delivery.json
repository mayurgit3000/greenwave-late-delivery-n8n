{
  "name": "GreenWave Late Delivery Assistant",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "id": "ab0a9a7c-4d1c-4e41-973f-c451fa0dff6d",
      "name": "Delay report received"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fd724ae7-26f7-4c44-b2fb-f562f60b670e",
              "name": "shipmentId",
              "value": "={{ ($json.chatInput.match(/GW-\\d+/i)?.[0] || '').toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "23a31530-693e-4378-bc23-140364afc917",
              "name": "delayMinutes",
              "value": "={{ (() => {\n  const text = String($json.chatInput || '').toLowerCase();\n  const h = text.match(/(\\d+(?:\\.\\d+)?)\\s*(hours?|hrs?|h)\\b/);\n  const m = text.match(/(\\d+)\\s*(minutes?|mins?|min|m)\\b/);\n  const total = (h ? Number(h[1]) * 60 : 0) + (m ? Number(m[1]) : 0);\n  return Math.round(total);\n})() }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "id": "c7ddada3-9d31-480d-8b54-bac84d922e35",
      "name": "Parse report"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "724149af-812f-49c8-ad83-84771b80dcf5",
              "leftValue": "={{ $json.shipmentId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "f34f69b5-ad8b-4f68-91bf-72da53c4214c",
              "leftValue": "={{ Number($json.delayMinutes) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        440,
        300
      ],
      "id": "66524042-b821-4191-867d-66d01134f9c3",
      "name": "Valid report?"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short internal incident summary (1 sentence).\n\nShipment: {{ $json.shipmentId }}\nDelay minutes: {{ $json.delayMinutes }}\nMessage: {{ $('Delay report received').item.json.chatInput }}\n\nRules:\n- No advice, no bullet points.\n- Include the shipment ID and the delay in minutes.\nReturn only the sentence.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        680,
        200
      ],
      "id": "a658defa-8c8d-4f1a-9165-94cc82504220",
      "name": "Write incident summary"
    },
    {
      "parameters": {
        "model": "anthropic/claude-3.5-haiku",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        680,
        420
      ],
      "id": "2b8f1296-d38f-4521-a1b6-641f65e74e81",
      "name": "OpenRouter Chat Model"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fac577c7-6953-454a-aebc-d1afa34322ad",
              "name": "shipmentId",
              "value": "={{ $('Parse report').item.json.shipmentId }}",
              "type": "string"
            },
            {
              "id": "dedb068b-801d-4ff7-9863-c0fa9d3ab577",
              "name": "delayMinutes",
              "value": "={{ Number($('Parse report').item.json.delayMinutes) }}",
              "type": "number"
            },
            {
              "id": "2e2efdff-b518-41e7-9685-058372d2f454",
              "name": "priorityLevel",
              "value": "={{ (() => { const d = Number($('Parse report').item.json.delayMinutes || 0); return d >= 60 ? 'Critical' : (d > 30 ? 'High' : 'Low'); })() }}",
              "type": "string"
            },
            {
              "id": "19437714-d439-47dd-b27f-d71818e26d75",
              "name": "incidentSummary",
              "value": "={{ ($json.output || '').trim() }}",
              "type": "string"
            },
            {
              "id": "08a0e8f0-487a-4594-9e61-44f545fb7415",
              "name": "status",
              "value": "={{ Number($('Parse report').item.json.delayMinutes) > 30 ? 'Escalated (email sent)' : 'Logged (no escalation)' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        200
