              "type": "string"
            },
            {
              "id": "8cf18caf-05e0-4fd9-808e-52de999fecd7",
              "name": "incidentSummary",
              "value": "=Could not read a shipment ID (GW-1234) and delay from: \"{{ $('Delay report received').item.json.chatInput }}\"",
              "type": "string"
